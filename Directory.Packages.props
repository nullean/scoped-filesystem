<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!-- the library -->
  <ItemGroup>
    <PackageVersion Include="MinVer" Version="8.0.0" />
    <PackageVersion Include="System.IO.Abstractions" Version="22.3.0" />
  </ItemGroup>

  <!-- tests -->
  <ItemGroup>
    <PackageVersion Include="AwesomeAssertions" Version="9.6.0" />
    <PackageVersion Include="GitHubActionsTestLogger" Version="3.0.5" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="Nullean.VsTest.Pretty.TestLogger" Version="0.10.0" />
    <PackageVersion Include="System.IO.Abstractions.TestingHelpers" Version="22.3.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>

  <!-- build/scripts -->
  <ItemGroup>
    <!-- Nullean.Make.Fs needs FSharp.Core 11.0.100 or later; it brings Proc and Proc.Fs -->
    <PackageVersion Include="FSharp.Core" Version="11.0.100" />
    <PackageVersion Include="Nullean.Make.Fs" Version="0.25.0" />
  </ItemGroup>
</Project>
